{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/old-about",
      "dest": "/about.html",
      "status": 301
    },
    {
      "src": "/old-projects",
      "dest": "/projects.html",
      "status": 301
    },
    {
      "src": "/old-contact",
      "dest": "/contact.html",
      "status": 301
    },
    {
      "src": "/legacy-blog",
      "dest": "/blog.html",
      "status": 301
    },
    {
      "src": "/old-tools",
      "dest": "/tools.html",
      "status": 301
    },
    {
      "src": "/about/",
      "dest": "/about.html",
      "status": 301
    },
    {
      "src": "/projects/",
      "dest": "/projects.html",
      "status": 301
    },
    {
      "src": "/contact/",
      "dest": "/contact.html",
      "status": 301
    },
    {
      "src": "/blog/",
      "dest": "/blog.html",
      "status": 301
    },
    {
      "src": "/tools/",
      "dest": "/tools.html",
      "status": 301
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
} 